# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# -----------------------------------------------------------------------------

# ---- Telegram bot ----
# Get the token from @BotFather. TELEGRAM_CHAT_ID is the numeric ID of the
# group / DM the digest should be posted to; run the bot once and send /start
# in the target chat to get it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: comma-separated list of chat_ids that are allowed to talk to the
# interactive bot. Leave blank to allow anyone.
ALLOWED_CHATS=

# ---- Azure OpenAI ----
# The LLM is used for the evening "note of the day", attachment summaries, and
# the Q&A bot. To swap providers, edit mcb_digest/llm.py.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Optional: email digest (SMTP) ----
# The default runtime posts to Telegram only. If you also want email, set these
# and call `run_digest.py` without --dry-run. Use a Gmail app-password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER=
SMTP_PASSWORD=
DIGEST_RECIPIENTS=

# ---- Optional: MCB tenant overrides ----
# The defaults point at CHIREC's MCB tenant. If your school runs on a
# different MCB subdomain, override the two URLs here (no trailing slash).
# MCB_BASE_URL=https://<yourschool>.myclassboard.com
# MCB_SSO_URL=https://ssolive.myclassboard.com

# ---- Optional: parent display name (used in the LLM system prompt) ----
# PARENT_NAMES=Alex & Sam

# ---- Optional: data window ----
# Earliest date the scraper / event store will accept (ISO). Bump this at the
# start of a new academic year to drop stale events. Defaults to the value
# baked into mcb_digest/config.py if unset.
# DATA_FLOOR_DATE=2026-07-13
